[Unit]
Description=Ambilight Pro engine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/ambilight-pro
ExecStart=/usr/bin/python3 -m engine.main config/config.yaml
Restart=always
RestartSec=5
Nice=-10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
